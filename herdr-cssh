#!/usr/bin/env python3
"""herdr-cssh — ClusterSSH with Herdr.

Spawns one SSH session per host — each labeled with its host name — and then
stays alive in the foreground, mirroring your keystrokes to every session at
once so typing reaches them all. Think tmux-cssh / ClusterSSH without a Tk
GUI: one place, many hosts.

It talks to a running Herdr server over its local socket API, so it works
from any shell — inside a Herdr terminal or not. Two backends are supported
and auto-detected:

  herdr-app   (the `herdr-app` window over `herdr-core` / `hc`)
      Detected when $HC_TERMINAL_SOCKET is set. A tiled space in the running
      Herdr window: one SSH pane per host (space.new, then pane.split
      right/down), the tmux-cssh split view. Keystrokes typed in any pane of
      the group are mirrored to the others.

  herdr       (the `herdr` 0.9.x JSON socket API)
      Detected via ~/.config/herdr/herdr.sock (or $HERDR_SOCKET_PATH). A new
      workspace is created with a tiled tab — one labeled pane per host —
      and keystrokes are mirrored from the focused pane to the others.

Usage:
    herdr-cssh [options] host [host ...]

Options:
  -h              Show help
  -p <program>    Run <program> <host> instead of ssh <host> (default: ssh)
  -c              herdr backend: open a tab in the current workspace instead
                  of a new one
  -n <name>       Name of the group / workspace / tab (default: cssh)
  -o <ssh args>   Additional arguments passed to the program before the host

Run `herdr-cssh --list` to see which Herdr socket is available to this user.
"""

import json
import os
import select
import signal
import socket
import subprocess
import sys
import threading

PROG = "herdr-cssh"


def die(msg, code=1):
    sys.stderr.write(f"{PROG}: {msg}\n")
    sys.exit(code)


def usage(code=0):
    print(__doc__)
    sys.exit(code)


# --------------------------------------------------------------------------
# Backends
# --------------------------------------------------------------------------
# Each backend is a callable: run(hosts, opts) -> None. opts is a dict with
# keys: program, ssh_options, name, current, cwd, socket_path, caller.
# The backend creates the host sessions, then blocks mirroring keystrokes
# from the source (caller / focused pane) to the others until Ctrl-C.


class HerdrJson:
    """Request/response client for the herdr 0.9.x JSON socket API."""

    def __init__(self, path):
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.sock.settimeout(10)
        self.sock.connect(path)
        self.buf = b""
        self.next_id = 0
        self.lock = threading.Lock()
        self._closed = False

    def _read_msg(self):
        while True:
            while b"\n" in self.buf:
                line, self.buf = self.buf.split(b"\n", 1)
                line = line.strip()
                if line:
                    return json.loads(line)
            chunk = self.sock.recv(65536)
            if not chunk:
                self._closed = True
                raise ConnectionError("socket closed")
            self.buf += chunk

    def request(self, method, params=None):
        self.next_id += 1
        rid = f"r{self.next_id}"
        with self.lock:
            self.sock.sendall(
                json.dumps({"id": rid, "method": method, "params": params or {}})
                .encode() + b"\n"
            )
            while True:
                msg = self._read_msg()
                if msg.get("id") == rid:
                    if "error" in msg:
                        err = msg["error"]
                        raise RuntimeError(
                            f"{method}: {err.get('code')} {err.get('message')}"
                        )
                    return msg["result"]

    def poll_event(self, timeout=1.0):
        self.sock.settimeout(timeout)
        try:
            with self.lock:
                try:
                    return self._read_msg()
                except socket.timeout:
                    return None
        finally:
            self.sock.settimeout(10)

    def close(self):
        with self.lock:
            if self._closed:
                return
            self._closed = True
            try:
                self.sock.close()
            except OSError:
                pass


class HcCore:
    """Client for the herdr-core JSON-RPC 2.0 socket API (hc)."""

    def __init__(self, path):
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.sock.settimeout(10)
        self.sock.connect(path)
        self.buf = b""
        self.next_id = 0

    def request(self, method, params=None):
        self.next_id += 1
        rid = f"r{self.next_id}"
        self.sock.sendall(
            json.dumps(
                {"id": rid, "jsonrpc": "2.0", "method": method, "params": params or {}}
            ).encode() + b"\n"
        )
        while True:
            while b"\n" in self.buf:
                line, self.buf = self.buf.split(b"\n", 1)
                line = line.strip()
                if line:
                    msg = json.loads(line)
                    if msg.get("id") == rid:
                        if "error" in msg:
                            err = msg["error"]
                            raise RuntimeError(
                                f"{method}: {err.get('code')} {err.get('message')}"
                            )
                        return msg["result"]
            chunk = self.sock.recv(65536)
            if not chunk:
                raise ConnectionError("socket closed")
            self.buf += chunk

    def close(self):
        try:
            self.sock.close()
        except OSError:
            pass


def host_argv(host, program, ssh_options):
    argv = [program]
    if ssh_options:
        argv += ssh_options
    argv.append(host)
    return argv


def app_do(*args):
    """Run `herdr-app do <args...>` and return the parsed JSON result."""
    out = subprocess.run(
        ["herdr-app", "do", *args],
        capture_output=True, text=True, timeout=30,
    )
    if out.returncode != 0:
        raise RuntimeError(f"herdr-app do failed: {out.stderr.strip() or out.stdout.strip()}")
    try:
        return json.loads(out.stdout)
    except json.JSONDecodeError:
        return {"raw": out.stdout}


def app_ls():
    out = subprocess.run(
        ["herdr-app", "ls"], capture_output=True, text=True, timeout=30,
    )
    return json.loads(out.stdout)


def _pane_for(space_id, terminal):
    """Return the pane ID showing `terminal` in `space_id`, or None."""
    try:
        data = app_ls()
    except Exception:
        return None
    for sp in data.get("spaces", []):
        if sp.get("id") != space_id:
            continue
        for tb in sp.get("tabs", []):
            for t in tb.get("terminals", []):
                if t.get("terminal") == terminal:
                    return t.get("pane")
    return None


def _current_pane():
    """Return (space_id, pane_id) of the focused pane, or (None, None)."""
    data = app_ls()
    for sp in data.get("spaces", []):
        if not sp.get("active"):
            continue
        for tb in sp.get("tabs", []):
            if not tb.get("active"):
                continue
            for t in tb.get("terminals", []):
                if t.get("pane"):
                    return sp["id"], t["pane"]
    return None, None


def run_core(hosts, opts):
    """herdr-app backend: a tiled space, one SSH pane per host.

    Builds the tmux-cssh-style split view in the running Herdr window:
    -c opens a tab in the current space, otherwise a new space named after
    the group. Hosts are tiled via space.new (first host) then pane.split
    (right, then down) on the first pane, so N hosts fill a grid.
    Keystrokes typed into any pane of the group are mirrored to the others.
    """
    path = opts["socket_path"]
    h = HcCore(path)
    cwd = opts["cwd"]
    name = opts["name"]

    terminals = []  # (host, terminal_address) in layout order
    space_id = None

    try:
        if opts["current"]:
            space_id, base_pane = _current_pane()
            if not space_id:
                die("could not find the focused Herdr space; is a space shown?")
            # First host goes into a new tab of the current space.
            r = app_do("tab.new", "--name", name, "--space", space_id,
                        "--folder", cwd, "--argv",
                        json.dumps(host_argv(hosts[0], opts["program"], opts["ssh_options"])),
                        "--focus", "false")
            term = r.get("terminal") or r.get("pane")
            terminals.append((hosts[0], term))
        else:
            r = app_do("space.new", "--name", name, "--folder", cwd,
                        "--argv",
                        json.dumps(host_argv(hosts[0], opts["program"], opts["ssh_options"])),
                        "--focus", "false")
            space_id = r.get("space")
            term = r.get("terminal")
            terminals.append((hosts[0], term))

        # Tiled positions for the remaining hosts: right, down, right, down...
        # Splitting the first pane repeatedly gives a grid that fills in order.
        directions = ["right", "down"] * 16
        first_term = terminals[0][1]
        for i, host in enumerate(hosts[1:]):
            pane = _pane_for(space_id, first_term)
            if not pane:
                # First pane disappeared (host exited); split the last live one.
                pane = _last_pane(space_id)
            if not pane:
                sys.stderr.write(f"{PROG}: could not place {host}; no live pane to split\n")
                continue
            direction = directions[i]
            r = app_do("pane.split", "--direction", direction, "--pane", pane,
                        "--argv",
                        json.dumps(host_argv(host, opts["program"], opts["ssh_options"])))
            term = r.get("terminal")
            terminals.append((host, term))

        # Label every terminal for the group (sync target set + identification).
        for host, term in terminals:
            if term:
                try:
                    h.request("terminal.label",
                              {"terminal": term, "labels": {"cssh": name, "host": host}})
                except Exception:
                    pass

        # Select the group so it is the one shown.
        app_do("space.select", "--id", space_id)

        sys.stderr.write(
            f"{PROG}: {len(terminals)} host(s) tiled in space '{name}' "
            f"({[t for _, t in terminals]})\n"
            f"{PROG}: typing in any pane of the group syncs to the others; "
            f"Ctrl-C stops.\n"
        )
        _mirror_core(h, path, [t for _, t in terminals if t])
    finally:
        h.close()


def _last_pane(space_id):
    """Return the last pane ID in a space (fallback split target)."""
    try:
        data = app_ls()
    except Exception:
        return None
    for sp in data.get("spaces", []):
        if sp.get("id") != space_id:
            continue
        panes = []
        for tb in sp.get("tabs", []):
            for t in tb.get("terminals", []):
                if t.get("pane"):
                    panes.append(t["pane"])
        return panes[-1] if panes else None
    return None


def _mirror_core(h, path, terminals):
    """Mirror keystrokes to every terminal in `terminals`.

    Observes each terminal's surface; input seen on one is replayed to the
    rest. (Best-effort: a terminal whose surface is unreadable is skipped.)
    """
    stop = {"stop": False}

    def on_sig(_s, _f):
        stop["stop"] = True

    try:
        signal.signal(signal.SIGINT, on_sig)
        signal.signal(signal.SIGTERM, on_sig)
    except ValueError:
        pass

    # One observe connection per terminal.
    conns = []
    for term in terminals:
        try:
            c = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            c.settimeout(0.3)
            c.connect(path)
            c.sendall(
                json.dumps(
                    {"id": "a1", "jsonrpc": "2.0", "method": "terminal.attach",
                     "params": {"terminal": term, "observe": True, "cols": 200, "rows": 50}}
                ).encode() + b"\n"
            )
            conns.append((term, c))
        except OSError:
            pass

    try:
        while not stop["stop"]:
            rlist, _, _ = select.select([c for _, c in conns], [], [], 0.3)
            for c in rlist:
                term = next(t for t, cc in conns if cc is c)
                try:
                    data = c.recv(65536)
                except (BlockingIOError, socket.timeout):
                    continue
                except OSError:
                    data = b""
                if not data:
                    continue
                text = data.decode("utf-8", "replace")
                for other in terminals:
                    if other == term:
                        continue
                    try:
                        h.request("terminal.send", {"terminal": other, "text": text})
                    except Exception:
                        pass
    finally:
        for _, c in conns:
            try:
                c.close()
            except OSError:
                pass


def balanced_tree(nodes):
    """Pair nodes into a balanced BSP split tree (equal ratios)."""
    if len(nodes) == 1:
        return nodes[0]
    mid = len(nodes) // 2
    return {
        "type": "split",
        "direction": "right",
        "ratio": 0.5,
        "first": balanced_tree(nodes[:mid]),
        "second": balanced_tree(nodes[mid:]),
    }


def collect_pane_ids(node, acc):
    if node["type"] == "pane":
        acc.append(node["pane_id"])
    else:
        collect_pane_ids(node["first"], acc)
        collect_pane_ids(node["second"], acc)
    return acc


def run_herdr(hosts, opts):
    """herdr 0.9.x backend: a tiled tab, one labeled pane per host."""
    path = opts["socket_path"]
    h = HerdrJson(path)
    try:
        if opts["current"]:
            try:
                cur = h.request("pane.current", {})
                workspace_id = cur["pane"]["workspace_id"]
            except Exception as e:
                die(f"could not read the current Herdr pane ({e}); is a pane focused?")
            tabs = h.request("tab.list", {"workspace_id": workspace_id})["tabs"]
            used = {t.get("label") for t in tabs}
            label, n = opts["name"], 0
            while label in used:
                n += 1
                label = f"{opts['name']}-{n}"
        else:
            ws = h.request("workspace.create",
                           {"label": opts["name"], "cwd": opts["cwd"]})
            workspace_id = ws["workspace"]["workspace_id"]
            label = opts["name"]

        panes = [
            {
                "type": "pane",
                "label": host,
                "cwd": opts["cwd"],
                "command": host_argv(host, opts["program"], opts["ssh_options"]),
            }
            for host in hosts
        ]
        root = balanced_tree(panes)
        result = h.request(
            "layout.apply",
            {
                "workspace_id": workspace_id,
                "tab_label": label,
                "focus": True,
                "root": root,
            },
        )
        layout = result["layout"]
        tab_id = layout["tab_id"]
        pane_ids = collect_pane_ids(layout["root"], [])

        sys.stderr.write(
            f"{PROG}: {len(panes)} host(s) in tab '{label}' "
            f"(workspace {workspace_id}, herdr)\n"
            f"{PROG}: typing in the focused pane syncs to the others; "
            f"Ctrl-C stops.\n"
        )
        _mirror_herdr(h, tab_id, pane_ids)
    finally:
        h.close()


def _mirror_herdr(h, tab_id, panes):
    """Track the focused pane of the tab and mirror input to the others."""
    stop = {"stop": False, "focused": None}
    panes = list(panes)

    h.request("events.subscribe", {
        "subscriptions": [{"type": "pane.focused"}, {"type": "tab.focused"}],
    })
    try:
        lay = h.request("pane.layout", {"pane_id": panes[0]})
        stop["focused"] = lay["layout"].get("focused_pane_id")
    except Exception:
        stop["focused"] = None

    def tracker():
        while not stop["stop"]:
            ev = h.poll_event(timeout=1.0)
            if ev is None:
                continue
            data = ev.get("data", {})
            if ev.get("event") == "pane_focused":
                pid = data.get("pane_id")
                if pid in panes:
                    stop["focused"] = pid

    t = threading.Thread(target=tracker, daemon=True)
    t.start()

    def on_sig(_s, _f):
        stop["stop"] = True

    try:
        signal.signal(signal.SIGINT, on_sig)
        signal.signal(signal.SIGTERM, on_sig)
    except ValueError:
        pass

    try:
        while not stop["stop"]:
            select.select([], [], [], 0.5)
    finally:
        stop["stop"] = True
        t.join(timeout=2)


# --------------------------------------------------------------------------
# Socket discovery
# --------------------------------------------------------------------------

def xdg_config_home():
    return os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")


def detect():
    """Return (backend, socket_path, caller) for the available Herdr runtime."""
    # 1. herdr-core (the hc / herdr-app runtime).
    hc = os.environ.get("HC_TERMINAL_SOCKET")
    if hc and _alive(hc, kind="core"):
        return "core", hc, os.environ.get("HC_TERMINAL_ID")
    # 2. herdr JSON API: $HERDR_SOCKET_PATH, then default, then sessions.
    cands = []
    if os.environ.get("HERDR_SOCKET_PATH"):
        cands.append(os.environ["HERDR_SOCKET_PATH"])
    base = os.path.join(xdg_config_home(), "herdr")
    if os.path.isdir(base):
        cands.append(os.path.join(base, "herdr.sock"))
        sessions = os.path.join(base, "sessions")
        if os.path.isdir(sessions):
            for name in sorted(os.listdir(sessions)):
                cands.append(os.path.join(sessions, name, "herdr.sock"))
    for path in cands:
        if os.path.exists(path) and _alive(path, kind="herdr"):
            return "herdr", path, None
    return None, None, None


def _alive(path, kind):
    if not os.path.exists(path):
        return False
    if kind == "core":
        client = HcCore
        method, params = "terminal.list", {}
    else:
        client = HerdrJson
        method, params = "ping", {}
    try:
        h = client(path)
        h.request(method, params)
        h.close()
        return True
    except Exception:
        return False


def list_sockets():
    backend, path, _ = detect()
    print(f"active backend : {backend or 'none'}")
    print(f"active socket  : {path or '-'}")
    print("\nall candidates:")
    print(f"  {'kind':8} {'socket':60} state")
    rows = []
    hc = os.environ.get("HC_TERMINAL_SOCKET")
    if hc:
        rows.append(("core", hc, os.path.exists(hc) and _alive(hc, "core")))
    base = os.path.join(xdg_config_home(), "herdr")
    if os.path.isdir(base):
        p = os.path.join(base, "herdr.sock")
        rows.append(("herdr", p, os.path.exists(p) and _alive(p, "herdr")))
        sessions = os.path.join(base, "sessions")
        if os.path.isdir(sessions):
            for name in sorted(os.listdir(sessions)):
                sp = os.path.join(sessions, name, "herdr.sock")
                rows.append(("herdr", sp, os.path.exists(sp) and _alive(sp, "herdr")))
    for kind, p, ok in rows:
        state = "alive" if ok else ("absent" if not os.path.exists(p) else "stale")
        print(f"  {kind:8} {p:60} {state}")
    if not backend:
        print("\nNo live Herdr runtime. Start one with `herdr` (or `hc server start`).")


# --------------------------------------------------------------------------
# Main
# --------------------------------------------------------------------------

def main():
    args = sys.argv[1:]
    if args and args[0] in ("-h", "--help"):
        usage(0)
    if args and args[0] == "--list":
        list_sockets()
        return

    hosts = []
    program = "ssh"
    ssh_options = []
    name = "cssh"
    current = False

    i = 0
    while i < len(args):
        a = args[i]
        if a == "-h":
            usage(0)
        elif a == "-p":
            i += 1
            if i >= len(args):
                die("-p requires a program")
            program = args[i]
        elif a == "-c":
            current = True
        elif a == "-n":
            i += 1
            if i >= len(args):
                die("-n requires a name")
            name = args[i]
        elif a == "-o":
            i += 1
            if i >= len(args):
                die("-o requires arguments")
            ssh_options = args[i].split()
        elif a.startswith("-"):
            usage(2)
        else:
            hosts.append(a)
        i += 1

    if not hosts:
        usage(2)

    backend, path, caller = detect()
    if not backend:
        die("no live Herdr runtime. Start one with `herdr` (or `hc server start`), "
            "or run herdr-cssh from inside a Herdr terminal. See `herdr-cssh --list`.")

    opts = {
        "program": program,
        "ssh_options": ssh_options,
        "name": name,
        "current": current,
        "cwd": os.getcwd(),
        "socket_path": path,
        "caller": caller,
    }

    try:
        if backend == "core":
            run_core(hosts, opts)
        else:
            run_herdr(hosts, opts)
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()
